# ==============================================================================
# CampusConnect Backend - Environment Variables Template
# Copy this file to .env or set these in your deployment environment.
# DO NOT COMMIT REAL CREDENTIALS, PASSWORDS, OR SECRETS TO GIT.
# ==============================================================================

# Database Connection (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/campusconnect
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Standard Spring Boot DataSource environment variables (alternative)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/campusconnect
# SPRING_DATASOURCE_USERNAME=your_database_username
# SPRING_DATASOURCE_PASSWORD=your_database_password

# JWT Authentication Secret (Must be a 256-bit / 32-byte or longer hex/base64 key)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION_MS=86400000
